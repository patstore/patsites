{
  "name": "@repo/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared layout architecture: scroll, page transitions, SEO, animations, and localization",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./content": {
      "types": "./src/content/public.ts",
      "default": "./src/content/public.ts"
    },
    "./vite": {
      "types": "./src/content/plugin.ts",
      "default": "./src/content/plugin.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --test src/localization/path.test.ts src/transitions/match.test.ts src/content/scan-content.test.ts src/content/routes.test.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.17"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "10.9.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2",
    "vite": "^8.0.0"
  }
}
