# Read on the server. VITE_ names are accepted.
# Real environment variables win over these files.
VITE_PATSTORE_GRAPHQL_API_URL=
VITE_PATSTORE_API_URL=
VITE_PATSTORE_PROJECT_ID=
VITE_PATSTORE_APP_ID=
VITE_PATSTORE_REST_KEY=
VITE_PATSTORE_FILE_URL=

# Optional. The contact form posts with the master key when it is set.
VITE_PATSTORE_MASTER_KEY=
VITE_PATSTORE_CLIENT_KEY=

# Optional canonical origin. Defaults to the request origin.
SITE_URL=
