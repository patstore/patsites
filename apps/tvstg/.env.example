# Read on the server. VITE_, unprefixed, and legacy GATSBY_ names are accepted.
# Real environment variables win over these files.
VITE_PATSTORE_GRAPHQL_API_URL=
VITE_PATSTORE_API_URL=
VITE_PATSTORE_PROJECT_ID=
VITE_PATSTORE_APP_ID=
VITE_PATSTORE_REST_KEY=
VITE_PATSTORE_FILE_URL=

# Optional. Form writes use the REST key.
PATSTORE_MASTER_KEY=

# Public account id, delivered to the client through the root loader.
BYTESCALE_ACCOUNT_ID=

# Optional canonical origin for the sitemap. Defaults to the request origin.
SITE_URL=
