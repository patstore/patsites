{
  "name": "patsites",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:koloproktologie": "turbo dev --filter=koloproktologie",
    "dev:coloproktologen": "turbo dev --filter=coloproktologen",
    "dev:tvstg": "turbo dev --filter=tvstg",
    "dev:hebammenteam": "turbo dev --filter=hebammenteam",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
